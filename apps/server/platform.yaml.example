# 复制为 platform.yaml 后启动后端（不要把填了密钥的文件提交进 git）。
# 查找顺序：环境变量 PLATFORM_CONFIG，否则 apps/server/platform.yaml。
# ${VAR} 从进程环境读取，未设置则启动失败。

# 独立 Claude Home，不使用本机 ~/.claude
claude_home: ./data/claude-home

# generate-api-tests 的 vendor；none 表示只用核心 skill
vendor: none

# 每个目录下含 SKILL.md 的子目录都会链到 claude_home/skills/
skill_roots:
  - ../../skills
  # - /opt/api-test-skills-ctrip/skills

# 只声明平台要用的 MCP。不要依赖本机 ~/.claude.json。
# auth: oauth 时平台会从 MCP 的 RFC 9728 资源元数据发现授权服务器，
# 用 device code 登录后把 Bearer 注入请求。IdP 地址不要写死在代码里。
mcp_servers: {}
# example-mcp:
#   type: http
#   url: ${EXAMPLE_MCP_URL}
#   auth: oauth
#   headers:
#     X-Api-Key: ${EXAMPLE_MCP_TOKEN}

# 与侧栏用户名对齐时读取的 userinfo 字段（默认 OpenID：email / mail / preferred_username / sub / name）
# oauth:
#   identity_claims:
#     - email
#     - preferred_username

# model:
#   name: ${ANTHROPIC_CUSTOM_MODEL_OPTION}
#   base_url: ${ANTHROPIC_BASE_URL}
#   auth_token: ${ANTHROPIC_AUTH_TOKEN}

# 被测仓库 git clone 用。只改写 http(s) 地址，工作区用 insteadOf 记住凭证，
# 不写进会话的 git_url。未配置则仍走机器上的 Git 凭据。
# git:
#   token: ${PLATFORM_GIT_TOKEN}
#   username: oauth2
